# Copy to .env and fill in. .env is listed in .gitignore and .dockerignore.
# Optional: switches on the LLM interaction layer. Without it the bot runs on templates.
GROQ_API_KEY=
# Optional: Groq model ID for the interaction layer (check console.groq.com/docs/models).
ABC_LLM_MODEL=openai/gpt-oss-20b
# Secret for phone-number tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
ABC_PII_KEY=
# Optional: folder for the audit repository. Default: ./logs. Leave this commented out under Docker:
# the image already sets it to /app/data, the mounted volume.
# ABC_AUDIT_DIR=
# Set to 1 to stop automated decisions and refer every application to a loan officer.
ABC_KILL_SWITCH=0
